# RAGG settings. Copy to .env, or (easier) set them in the app: gear icon, top left.
# Every value is optional; the defaults are shown.

# --- API keys ---
# DeepSeek API key: From platform.deepseek.com. The default provider.
DEEPSEEK_API_KEY=
# Groq API key: From console.groq.com (optional).
GROQ_API_KEY=
# OpenAI API key: From platform.openai.com (optional).
OPENAI_API_KEY=
# Gemini API key: From aistudio.google.com (optional).
GEMINI_API_KEY=

# --- Answering ---
# Provider: Which LLM writes the answers. Switching needs only that provider's key.
#   one of: deepseek | groq | openai | gemini
LLM_PROVIDER=deepseek
# Model (optional): Leave empty for the provider's default: DeepSeek deepseek-chat, Groq llama-3.3-70b-versatile, OpenAI gpt-4o-mini, Google Gemini gemini-2.0-flash.
LLM_MODEL=
# Temperature: Lower = more literal answers. 0.1 suits code questions.
LLM_TEMPERATURE=0.1
# Longest answer
LLM_MAX_TOKENS=1200

# --- Retrieval ---
# Search
#   one of: hybrid | dense | sparse
RETRIEVAL_MODE=hybrid
# Re-rank with the cross-encoder: More accurate ordering; adds a fraction of a second per question on a laptop CPU.
#   one of: on | off
RERANK=on
# Code chunks given to the LLM
TOP_K=6
# Candidates per search: How many results each search (meaning, keywords) returns before fusion.
CANDIDATES=30
# Candidates re-ranked: Fewer = faster re-ranking on slow machines.
RERANK_CANDIDATES=20
# RRF constant k: Reciprocal Rank Fusion: score = sum of 1/(k + rank). 60 is the standard value.
RRF_K=60

# --- Indexing ---
# Chunking: Applies to repos indexed (or re-indexed) after the change.
#   one of: ast | window
CHUNKER=ast
# Window size: Fixed-window chunking, and the fallback for files tree-sitter can't parse.
WINDOW_LINES=60
# Window overlap
WINDOW_OVERLAP=15
# Embedding model: Runs locally on the CPU. Downloaded once. Changing it needs a re-index.
#   one of: BAAI/bge-small-en-v1.5 | jinaai/jina-embeddings-v2-base-code | BAAI/bge-base-en-v1.5
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Embedding batch size: Lower it if indexing runs out of memory on a small laptop.
EMBED_BATCH=32
# Skip files larger than
MAX_FILE_KB=300
# Also ignore (globs): Comma-separated, on top of .gitignore, e.g. docs/**, *.min.js
EXTRA_IGNORE=

# --- Storage ---
# Qdrant server URL (optional): Empty = embedded Qdrant in the data/ folder (no server needed).
QDRANT_URL=
QDRANT_API_KEY=
