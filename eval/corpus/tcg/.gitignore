# Secrets — never commit the real .env (only .env.example is tracked)
.env

# Local data: SQLite database, cached API responses, decision output, raw eval
# runs. The one exception is the measured eval write-up, data/eval/RESULTS.md.
data/*
!data/eval/
data/eval/*
!data/eval/RESULTS.md

