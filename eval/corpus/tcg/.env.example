# Copy this file to .env and fill in real values. .env is gitignored.
# Everything here can also be edited in the binder: Settings (top-left gear).
# Leave a line out (or blank) to use its default.

# --- API keys ---
# LLM provider key. Without it, decisions use the built-in rules instead.
LLM_API_KEY=
# JustTCG key (free plan: 100 requests/day, personal use), for RUN_SOURCE=justtcg.
JUSTTCG_API_KEY=
# Optional pokemontcg.io key (raises its rate limit).
POKEMONTCG_API_KEY=
# tcgapi.net key, for RUN_SOURCE=tcgapi.
TCGAPI_KEY=

# --- AI model (any OpenAI-compatible provider; defaults target DeepSeek) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- Agent runs ---
# mock | pokemontcg | justtcg | tcgapi | mcp   (what "Re-run agent" and `python -m src.run` use)
RUN_SOURCE=mock
# The source the MCP server wraps (for RUN_SOURCE=mcp and other MCP clients)
MCP_SOURCE=justtcg
# auto | on | off
RUN_LLM=auto

# --- Decision rules (percent) ---
BUY_EDGE_PCT=15
STRONG_EDGE_PCT=20
BIG_GAIN_PCT=50
TREND_THRESHOLD_PCT=3

# --- Live data ---
CACHE_TTL_HOURS=24
REQUEST_INTERVAL_S=1

# --- Agent ---
# Run once a day while the binder is open (on | off), at this local time.
AUTO_RUN=on
RUN_TIME=09:00
# Let the LLM look things up before deciding (on | off), at most N look-ups per card (0-5).
AGENT_TOOLS=on
AGENT_TOOL_BUDGET=3
# Alert when a price moves this much in a week (percent).
ALERT_MOVE_PCT=15
# Optional: Discord/Slack incoming-webhook URL to receive alerts.
ALERT_WEBHOOK_URL=
# Optional: monthly buying budget for the collection review (0 = none).
BUY_BUDGET=0
# Optional: your SearXNG instance (JSON output enabled) to give the LLM a web_search tool.
SEARXNG_URL=
